# Copy to .env, fill in, then: chmod 600 .env

# GitHub OAuth app (callback URL: https://<NGROK_DOMAIN>/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=your-github-username

# ngrok agent, started by start.sh (public URL: https://NGROK_DOMAIN)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.dev
# NGROK_BIN=ngrok                 # path to the ngrok binary if it isn't on PATH

# Server
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_BASE_URL=https://your-name.ngrok-free.dev   # defaults to https://$NGROK_DOMAIN
# SHELL_CWD=/data/data/com.termux/files/home        # where shell commands start; defaults to $HOME

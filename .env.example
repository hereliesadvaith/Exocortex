# Copy to .env, fill in, then: chmod 600 .env

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# MCP server (GitHub OAuth app; callback URL: https://<NGROK_DOMAIN>/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=your-github-username
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_BASE_URL=https://your-name.ngrok-free.dev   # defaults to https://$NGROK_DOMAIN

# ngrok (tunnel started by server.py; base URL is https://NGROK_DOMAIN)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.dev

# Query limits
# QUERY_TIMEOUT_MS=15000
# QUERY_MAX_ROWS=500

# Shell access + self-update tools for the assistant (see README). Off by default.
# ENABLE_SHELL=true
